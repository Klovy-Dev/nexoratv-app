<?xml version="1.0" encoding="utf-8"?>
<!-- Bannière affichée sur l'écran d'accueil Android TV / Fire TV (ratio 16:9).
     Dégradé signature NexoraTV (rose -> violet -> bleu) + logo centré. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#E8348C"
                android:centerColor="#8B5CF6"
                android:endColor="#2D7DF6"
                android:angle="315"/>
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center"
        android:width="140dp"
        android:height="140dp"/>
</layer-list>
