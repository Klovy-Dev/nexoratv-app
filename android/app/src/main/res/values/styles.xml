<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- NexoraTV est une app à thème sombre : le fond de la fenêtre Android
         (visible pendant l'init de Flutter, et derrière l'UI) doit être noir
         quel que soit le mode clair/sombre du système — sinon flash blanc au
         démarrage sur les appareils non "dark mode" (Fire OS notamment). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Splash affiché pendant le démarrage du process, retiré à la
             première frame Flutter. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <!-- Thème appliqué dès que le process a démarré : détermine la couleur de
         la fenêtre Android pendant l'init de l'UI Flutter, et derrière elle. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
